# Backend Configuration

# ============================================================================
# SUPABASE
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ============================================================================
# META MUSE API (Vision for Grocery Analysis)
# ============================================================================
# Get your API key from: https://ai.developer.meta.com
# 1. Go to API Keys tab
# 2. Click "Create API Key"
# 3. Copy immediately (shown only once)
# Never commit this file with real keys - use a .env file locally
MUSE_API_KEY=your_meta_api_key_here

# Optional: Override the API endpoint (default: https://api.meta.ai/v1)
# MUSE_API_BASE_URL=https://api.meta.ai/v1

# Optional: Specify which Muse Spark model to use
# Available: muse-spark-1.3 (latest/default), muse-spark-1.2, muse-spark-1.1
# MUSE_MODEL=muse-spark-1.3

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
PORT=8000

# ============================================================================
# OPENAI API (Vision API fallback for vision analysis)
# ============================================================================
# Optional: Get key from https://platform.openai.com/api-keys
# Used as fallback if Muse API is unavailable
# OPENAI_API_KEY=sk-...

# ============================================================================
# ANTHROPIC (Linq agent for matching)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-...
