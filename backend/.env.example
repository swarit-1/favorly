# MongoDB
MONGODB_URI=mongodb+srv://favorly_admin:PASSWORD@favorly-demo.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=favorly
MONGODB_DB_NAME=favorly_demo

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...  # anon key

# Direct Postgres connection string (Settings -> Database in the Supabase
# dashboard). Used only to apply schema.sql on startup -- set this to the SAME
# instance as agents/.env's DATABASE_URL if you want both services' schemas
# (backend's users/trips/... and agents' people/claims/...) living in one
# Supabase project.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Firebase
FIREBASE_KEY_PATH=/path/to/favorly-demo-firebase-adminsdk-xxxxx.json
FIREBASE_PROJECT_ID=favorly-demo

# Server
ENVIRONMENT=development
PORT=8000

# API Keys (for VLM, will be added in Lane B)
# OPENAI_API_KEY=sk-...
# MUSE_API_KEY=...
# MUSE_BASE_URL=...

# Trellis agent + graph service (see /agents)
TRELLIS_BASE_URL=http://localhost:8010
