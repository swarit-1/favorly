# Root env for the agents service (/agents). python-dotenv walks up from
# agents/config.py and finds this file.
#
# backend/ keeps its own .env: it needs PORT=8000 where agents needs 8010,
# plus the SUPABASE_URL/KEY vars its Supabase client uses.
#
# Postgres / Supabase connection string (service role — bypasses RLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trellis

# Set to 1 to run entirely on fixture responses, no network calls, no API key needed.
# This is the default for local dev / demo rehearsal without credits.
MOCK_LLM=1

# OpenAI-compatible endpoints (used when MOCK_LLM=0)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Texting service (outbound intro proposals land here)
TEXTING_SERVICE_URL=http://localhost:9000

# Decay half-life-ish constant, seconds. Spec default is 30 days (2592000).
# Use a short value (e.g. 120) for a demo where decay should be visible on stage.
EDGE_DECAY_SECONDS=2592000

PORT=8010
ENVIRONMENT=development
